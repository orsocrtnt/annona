// =============================================================================
// TUTELLIV — Schéma de base de données fondamental
// =============================================================================
// Ce schéma définit les entités fondamentales du système.
// Les modules métier futurs (Deliveries, Orders, Drivers, etc.) sont anticipés
// via les relations et commentaires documentés ci-dessous.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

/// Rôles système prédéfinis — utilisés pour le RBAC
enum SystemRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  MINI_ADMIN
  DISPATCHER
  DRIVER
  CLIENT
}

/// Statut d'un compte utilisateur
enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

/// Statut d'une entreprise
enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TRIAL
}

enum OrderStatus {
  QUOTE_REQUESTED
  PENDING
  ASSIGNED
  PURCHASING
  IN_DELIVERY
  DELIVERED
  INVOICED
  PAID
  CANCELLED
  FAILED
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PURCHASING
  IN_DELIVERY
  DELIVERED
  INVOICED
  PAID
  CANCELLED
  FAILED
}

enum DeliveryCategory {
  STANDARD
  COURIER
  SPECIAL_MISSION
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum OrderSource {
  ADMIN
  CLIENT
  RECURRING
}

enum OperationJobType {
  AUTO_DISPATCH
  CLIENT_NOTIFICATION
}

enum OperationJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum RecurrenceFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum RecurrenceUnit {
  DAYS
  WEEKS
  MONTHS
}

enum RecurrenceStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum SupportContactType {
  ADMIN
  DRIVER
}

enum SaasCatalogStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum SaasPlanCode {
  STARTER
  PRO
  BUSINESS
}

enum SaasSubscriptionKind {
  COMMERCIAL
  PILOT
  LEGACY
}

enum SaasSubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  RESTRICTED
  READ_ONLY
  CANCEL_AT_PERIOD_END
  CANCELLED
  EXPIRED
}

enum SaasBillingInterval {
  MONTHLY
  ANNUAL
}

enum SaasSubscriptionItemKind {
  OPTION
  DRIVER_SEAT
  ADMIN_SEAT
  DISPATCHER_SEAT
}

enum SaasSubscriptionItemSource {
  INITIAL
  ADDED_LATER
}

enum SaasUsageEventKind {
  ORDER_CREATED
  ORDER_REVERSED
}

enum DemoPoolState {
  PREPARING
  READY
  LEASED
  RECYCLING
  QUARANTINED
}

enum SignupStatus {
  DRAFT
  EMAIL_PENDING
  EMAIL_VERIFIED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  ACTIVATED
  FAILED
}

enum SignupPaymentStatus {
  PENDING
  CONFIRMED
  DECLINED
}

// -----------------------------------------------------------------------------
// CORE ENTITIES
// -----------------------------------------------------------------------------

/// Utilisateur du système — lié à Supabase Auth via authId
model User {
  id        String     @id @default(cuid())
  authId    String     @unique @map("auth_id")
  email     String     @unique
  firstName String     @map("first_name")
  lastName  String     @map("last_name")
  phone     String?
  avatarUrl String?    @map("avatar_url")
  settings  Json?      @default("{}")
  status    UserStatus @default(PENDING_VERIFICATION)

  // Relations
  companyId String?  @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id])

  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  lastLoginAt DateTime? @map("last_login_at")

  ordersAsCustomer     Order[]              @relation("CustomerOrders")
  deliveriesAsCustomer Delivery[]           @relation("CustomerDeliveries")
  deliveriesAsDriver   Delivery[]           @relation("DriverDeliveries")
  invoicesAsCustomer   Invoice[]            @relation("CustomerInvoices")
  supportTickets       SupportTicket[]      @relation("CustomerTickets")
  addresses            CustomerAddress[]
  recurringOrders      RecurringOrder[]
  driverLocation       DriverLocation?
  notifications        ClientNotification[]
  orderMessages        OrderMessage[]
  orderThreadReads     OrderThreadRead[]
  invoiceRemindersSent InvoiceReminder[]

  @@index([companyId])
  @@index([roleId])
  @@index([email])
  @@map("users")
}

model ClientNotification {
  id             String        @id @default(cuid())
  type           String
  title          String
  body           String
  href           String?
  readAt         DateTime?     @map("read_at")
  orderMessageId String?       @map("order_message_id")
  orderMessage   OrderMessage? @relation(fields: [orderMessageId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([orderMessageId])
  @@map("client_notifications")
}

/// Entreprise cliente — unité d'organisation principale (multi-tenant)
model Company {
  id       String        @id @default(cuid())
  name     String
  slug     String        @unique
  logoUrl  String?       @map("logo_url")
  email    String?
  phone    String?
  address  String?
  city     String?
  country  String?       @default("FR")
  status   CompanyStatus @default(TRIAL)
  isDemo   Boolean       @default(false) @map("is_demo")
  settings Json?         @default("{}")
  legalName         String? @map("legal_name")
  siren             String? @unique
  siret             String? @unique
  billingAddress    String? @map("billing_address")
  billingPostalCode String? @map("billing_postal_code")
  billingCity       String? @map("billing_city")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  users                User[]
  orders               Order[]
  deliveries           Delivery[]
  invoices             Invoice[]
  invoiceReminders     InvoiceReminder[]
  recurringOrders      RecurringOrder[]
  supportTickets       SupportTicket[]
  operationJobs        OperationJob[]
  saasSubscription     SaasSubscription?
  salesAttribution     SalesAttribution?
  saasUsagePeriods     SaasUsagePeriod[]
  saasUsageEvents      SaasUsageEvent[]
  saasSeatReservations SaasSeatReservation[]
  demoPoolEnvironment  DemoPoolEnvironment?
  signupJourney        SignupJourney?

  @@index([slug])
  @@index([status])
  @@map("companies")
}

/// Brouillon durable d'inscription. Le jeton de reprise n'est jamais stocké en clair.
model SignupJourney {
  id                 String              @id @default(cuid())
  resumeTokenHash    String              @unique @map("resume_token_hash")
  status             SignupStatus        @default(DRAFT)
  catalogVersionId   String              @map("catalog_version_id")
  catalogVersion     SaasCatalogVersion  @relation(fields: [catalogVersionId], references: [id], onDelete: Restrict)
  planCode           SaasPlanCode        @map("plan_code")
  billingInterval    SaasBillingInterval @map("billing_interval")
  optionSelections   Json                @default("[]") @map("option_selections")
  quoteSnapshot      Json                @map("quote_snapshot")
  email              String?
  authUserId         String?             @unique @map("auth_user_id")
  emailLinkTokenHash String?             @map("email_link_token_hash")
  firstName          String?             @map("first_name")
  lastName           String?             @map("last_name")
  companyName        String?             @map("company_name")
  legalName          String?             @map("legal_name")
  siren              String?
  siret              String?
  phone              String?
  billingAddress     String?             @map("billing_address")
  billingPostalCode  String?             @map("billing_postal_code")
  billingCity        String?              @map("billing_city")
  billingCountry     String               @default("FR") @map("billing_country")
  emailVerifiedAt    DateTime?            @map("email_verified_at")
  verificationEmailSentAt DateTime?       @map("verification_email_sent_at")
  paymentConfirmedAt DateTime?            @map("payment_confirmed_at")
  activatedAt        DateTime?            @map("activated_at")
  failureCode        String?               @map("failure_code")
  expiresAt          DateTime              @map("expires_at")
  companyId          String?               @unique @map("company_id")
  company            Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  salesCodeId        String?               @map("sales_code_id")
  salesCode          SalesCode?            @relation(fields: [salesCodeId], references: [id], onDelete: Restrict)

  paymentEvents SignupPaymentEvent[]
  billingAccount SaasBillingAccount?

  @@index([salesCodeId])
  @@index([email, status])
  @@index([catalogVersionId])
  @@index([siren, status])
  @@index([siret, status])
  @@index([expiresAt])
  @@map("signup_journeys")
}

model SignupPaymentEvent {
  id          String              @id @default(cuid())
  eventKey    String              @unique @map("event_key")
  signupId    String              @map("signup_id")
  signup      SignupJourney       @relation(fields: [signupId], references: [id], onDelete: Cascade)
  status      SignupPaymentStatus
  amountCents Int                 @map("amount_cents")
  currency    String              @default("EUR")
  snapshot    Json                @default("{}")
  receivedAt  DateTime            @default(now()) @map("received_at")
  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([signupId, receivedAt])
  @@map("signup_payment_events")
}

/// Environnement fictif préconstruit, attribué à une seule session de démo.
/// L'état persistant sert aussi de file de recyclage durable après une coupure worker.
model DemoPoolEnvironment {
  id                 String        @id @default(cuid())
  companyId          String        @unique @map("company_id")
  company            Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  poolKey            String        @default("public") @map("pool_key")
  slot               Int
  state              DemoPoolState @default(PREPARING)
  leaseKeyHash       String?       @unique @map("lease_key_hash")
  leasedAt           DateTime?     @map("leased_at")
  leaseExpiresAt     DateTime?     @map("lease_expires_at")
  recycleRequestedAt DateTime?     @map("recycle_requested_at")
  recycleStartedAt   DateTime?     @map("recycle_started_at")
  recycleAttempts    Int           @default(0) @map("recycle_attempts")
  lastFailureCode    String?       @map("last_failure_code")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  @@unique([poolKey, slot])
  @@index([poolKey, state, slot])
  @@index([state, leaseExpiresAt])
  @@map("demo_pool_environments")
}

/// Rôle — définit un ensemble de permissions
model Role {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  systemRole  SystemRole @map("system_role")
  isSystem    Boolean    @default(false) @map("is_system")

  // Relations
  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([systemRole])
  @@map("roles")
}

/// Permission — action granulaire sur une ressource
model Permission {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  resource    String
  action      String

  // Relations
  roles RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([resource, action])
  @@index([resource])
  @@map("permissions")
}

/// Table de liaison Role ↔ Permission (many-to-many)
model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// -----------------------------------------------------------------------------
// SAAS — catalogue, souscription, droits, quotas et compteurs
// -----------------------------------------------------------------------------

model SaasCatalogVersion {
  id          String            @id @default(cuid())
  code        String            @unique
  status      SaasCatalogStatus @default(DRAFT)
  currency    String            @default("EUR")
  vatRateBps  Int               @default(2000) @map("vat_rate_bps")
  effectiveAt DateTime          @map("effective_at")
  retiredAt   DateTime?         @map("retired_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  plans         SaasPlan[]
  options       SaasOption[]
  subscriptions SaasSubscription[]
  signupJourneys SignupJourney[]

  @@index([status, effectiveAt])
  @@map("saas_catalog_versions")
}

model SaasPlan {
  id                         String             @id @default(cuid())
  catalogVersionId           String             @map("catalog_version_id")
  catalogVersion             SaasCatalogVersion @relation(fields: [catalogVersionId], references: [id], onDelete: Restrict)
  code                       SaasPlanCode
  name                       String
  monthlyPriceCents          Int                @map("monthly_price_cents")
  annualPriceCents           Int                @map("annual_price_cents")
  includedDriverSeats        Int                @map("included_driver_seats")
  unlimitedDriverSeats       Boolean            @default(false) @map("unlimited_driver_seats")
  maxDriverSeats             Int?               @map("max_driver_seats")
  includedAdminSeats         Int                @map("included_admin_seats")
  maxAdminSeats              Int?               @map("max_admin_seats")
  includedDispatcherSeats    Int                @map("included_dispatcher_seats")
  maxDispatcherSeats         Int?               @map("max_dispatcher_seats")
  includedMonthlyOrders      Int                @map("included_monthly_orders")
  orderOverageUnitPriceCents Int                @map("order_overage_unit_price_cents")
  includedFeatures           String[]           @default([]) @map("included_features")
  createdAt                  DateTime           @default(now()) @map("created_at")
  updatedAt                  DateTime           @updatedAt @map("updated_at")

  assignments SaasPlanAssignment[]

  @@unique([catalogVersionId, code])
  @@index([code])
  @@map("saas_plans")
}

model SaasOption {
  id                String                   @id @default(cuid())
  catalogVersionId  String                   @map("catalog_version_id")
  catalogVersion    SaasCatalogVersion       @relation(fields: [catalogVersionId], references: [id], onDelete: Restrict)
  code              String
  name              String
  kind              SaasSubscriptionItemKind
  featureKey        String?                  @map("feature_key")
  seatRole          SystemRole?              @map("seat_role")
  monthlyPriceCents Int                      @map("monthly_price_cents")
  annualPriceCents  Int                      @map("annual_price_cents")
  applicablePlans   SaasPlanCode[]           @default([]) @map("applicable_plans")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  subscriptionItems SaasSubscriptionItem[]

  @@unique([catalogVersionId, code])
  @@index([kind])
  @@map("saas_options")
}

model SaasSubscription {
  id                     String                 @id @default(cuid())
  companyId              String                 @unique @map("company_id")
  company                Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  catalogVersionId       String?                @map("catalog_version_id")
  catalogVersion         SaasCatalogVersion?    @relation(fields: [catalogVersionId], references: [id], onDelete: Restrict)
  kind                   SaasSubscriptionKind
  status                 SaasSubscriptionStatus
  billingInterval        SaasBillingInterval?   @map("billing_interval")
  startsAt               DateTime               @map("starts_at")
  currentPeriodStart     DateTime               @map("current_period_start")
  currentPeriodEnd       DateTime?              @map("current_period_end")
  cancelAtPeriodEnd      Boolean                @default(false) @map("cancel_at_period_end")
  endedAt                DateTime?              @map("ended_at")
  premiumDiscoveryEndsAt DateTime?              @map("premium_discovery_ends_at")
  providerCustomerId     String?                @unique @map("provider_customer_id")
  providerSubscriptionId String?                @unique @map("provider_subscription_id")
  snapshot               Json                   @default("{}")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")

  billingAccount   SaasBillingAccount?
  planAssignments  SaasPlanAssignment[]
  items            SaasSubscriptionItem[]
  usagePeriods     SaasUsagePeriod[]
  usageEvents      SaasUsageEvent[]
  seatReservations SaasSeatReservation[]

  @@index([status])
  @@index([kind])
  @@index([catalogVersionId])
  @@map("saas_subscriptions")
}

model SaasPlanAssignment {
  id             String           @id @default(cuid())
  subscriptionId String           @map("subscription_id")
  subscription   SaasSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  planId         String           @map("plan_id")
  plan           SaasPlan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  effectiveFrom  DateTime         @map("effective_from")
  effectiveTo    DateTime?        @map("effective_to")
  snapshot       Json
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([subscriptionId, effectiveFrom])
  @@index([subscriptionId, effectiveTo])
  @@index([planId])
  @@map("saas_plan_assignments")
}

model SaasSubscriptionItem {
  id             String                     @id @default(cuid())
  subscriptionId String                     @map("subscription_id")
  subscription   SaasSubscription           @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  optionId       String?                    @map("option_id")
  option         SaasOption?                @relation(fields: [optionId], references: [id], onDelete: Restrict)
  code           String
  kind           SaasSubscriptionItemKind
  source         SaasSubscriptionItemSource @default(INITIAL)
  quantity       Int                        @default(1)
  unitPriceCents Int                        @map("unit_price_cents")
  effectiveFrom  DateTime                   @map("effective_from")
  effectiveTo    DateTime?                  @map("effective_to")
  snapshot       Json                       @default("{}")
  createdAt      DateTime                   @default(now()) @map("created_at")

  @@index([subscriptionId, effectiveFrom])
  @@index([subscriptionId, effectiveTo])
  @@index([optionId])
  @@map("saas_subscription_items")
}

model SaasUsagePeriod {
  id                         String           @id @default(cuid())
  subscriptionId             String           @map("subscription_id")
  subscription               SaasSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  companyId                  String           @map("company_id")
  company                    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  startsAt                   DateTime         @map("starts_at")
  endsAt                     DateTime         @map("ends_at")
  includedOrders             Int              @map("included_orders")
  orderCount                 Int              @default(0) @map("order_count")
  overageCount               Int              @default(0) @map("overage_count")
  orderOverageUnitPriceCents Int              @map("order_overage_unit_price_cents")
  closedAt                   DateTime?        @map("closed_at")
  createdAt                  DateTime         @default(now()) @map("created_at")
  updatedAt                  DateTime         @updatedAt @map("updated_at")

  events SaasUsageEvent[]

  @@unique([subscriptionId, startsAt])
  @@index([companyId, startsAt])
  @@map("saas_usage_periods")
}

model SaasUsageEvent {
  id             String             @id @default(cuid())
  eventKey       String             @unique @map("event_key")
  kind           SaasUsageEventKind
  quantity       Int                @default(1)
  companyId      String             @map("company_id")
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscriptionId String             @map("subscription_id")
  subscription   SaasSubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  usagePeriodId  String             @map("usage_period_id")
  usagePeriod    SaasUsagePeriod    @relation(fields: [usagePeriodId], references: [id], onDelete: Cascade)
  orderId        String?            @map("order_id")
  order          Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  reversedAt     DateTime?          @map("reversed_at")
  createdAt      DateTime           @default(now()) @map("created_at")

  @@unique([orderId, kind])
  @@index([companyId, createdAt])
  @@index([usagePeriodId, kind])
  @@index([subscriptionId])
  @@map("saas_usage_events")
}

model SaasSeatReservation {
  id             String           @id @default(cuid())
  reservationKey String           @unique @map("reservation_key")
  companyId      String           @map("company_id")
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscriptionId String           @map("subscription_id")
  subscription   SaasSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  role           SystemRole
  expiresAt      DateTime         @map("expires_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([companyId, role, expiresAt])
  @@index([subscriptionId])
  @@map("saas_seat_reservations")
}

// -----------------------------------------------------------------------------
// CLIENT PORTAL — Commandes, livraisons, factures
// -----------------------------------------------------------------------------

model Order {
  id          String      @id @default(cuid())
  reference   String      @unique
  status      OrderStatus @default(PENDING)
  source      OrderSource @default(ADMIN)
  totalAmount Decimal     @map("total_amount") @db.Decimal(10, 2)
  itemCount   Int         @default(1) @map("item_count")
  notes       String?

  deliveryCategory   DeliveryCategory @default(STANDARD) @map("delivery_category")
  pickupAddress      String?          @map("pickup_address")
  pickupCity         String?          @map("pickup_city")
  pickupPostalCode   String?          @map("pickup_postal_code")
  pickupInstructions String?          @map("pickup_instructions")

  shippingAddress       String?   @map("shipping_address")
  shippingCity          String?   @map("shipping_city")
  shippingPostalCode    String?   @map("shipping_postal_code")
  deliveryInstructions  String?   @map("delivery_instructions")
  requestedDeliveryDate DateTime? @map("requested_delivery_date")
  missionDescription    String?   @map("mission_description")

  companyId     String  @map("company_id")
  company       Company @relation(fields: [companyId], references: [id])
  customerId    String? @map("customer_id")
  customer      User?   @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: SetNull)
  customerEmail String? @map("customer_email")

  recurringOrderId String?         @map("recurring_order_id")
  recurringOrder   RecurringOrder? @relation(fields: [recurringOrderId], references: [id], onDelete: SetNull)

  idempotencyKey     String? @map("idempotency_key")
  requestFingerprint String? @map("request_fingerprint")

  items           OrderItem[]
  stops           OrderStop[]
  deliveries      Delivery[]
  invoices        Invoice[]
  tickets         SupportTicket[]
  messages        OrderMessage[]
  threadReads     OrderThreadRead[]
  saasUsageEvents SaasUsageEvent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([customerId, idempotencyKey])
  @@index([companyId])
  @@index([customerId])
  @@index([customerEmail])
  @@index([status])
  @@index([recurringOrderId])
  @@map("orders")
}

model OrderItem {
  id          String     @id @default(cuid())
  name        String
  quantity    Int        @default(1)
  unitPrice   Decimal    @map("unit_price") @db.Decimal(10, 2)
  orderId     String     @map("order_id")
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderStopId String?    @map("order_stop_id")
  orderStop   OrderStop? @relation(fields: [orderStopId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([orderStopId])
  @@map("order_items")
}

model OrderStop {
  id           String      @id @default(cuid())
  orderId      String      @map("order_id")
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sequence     Int
  label        String?
  address      String
  city         String?
  postalCode   String?     @map("postal_code")
  latitude     Float?
  longitude    Float?
  instructions String?
  items        OrderItem[]

  @@index([orderId])
  @@map("order_stops")
}

model Delivery {
  id                String           @id @default(cuid())
  reference         String           @unique
  status            DeliveryStatus   @default(PENDING)
  deliveryCategory  DeliveryCategory @default(STANDARD) @map("delivery_category")
  pickupAddress     String?          @map("pickup_address")
  pickupCity        String?          @map("pickup_city")
  pickupPostalCode  String?          @map("pickup_postal_code")
  pickupLatitude    Float?           @map("pickup_latitude")
  pickupLongitude   Float?           @map("pickup_longitude")
  address           String
  city              String?
  postalCode        String?          @map("postal_code")
  latitude          Float?
  longitude         Float?
  driverName        String?          @map("driver_name")
  driverId          String?          @map("driver_id")
  driver            User?            @relation("DriverDeliveries", fields: [driverId], references: [id], onDelete: SetNull)
  scheduledAt       DateTime?        @map("scheduled_at")
  estimatedArrival  DateTime?        @map("estimated_arrival")
  completedAt       DateTime?        @map("completed_at")
  missionAcceptedAt DateTime?        @map("mission_accepted_at")
  missionStartedAt  DateTime?        @map("mission_started_at")
  podOutcome        String?          @map("pod_outcome")
  podPhotoPath      String?          @map("pod_photo_path")
  podFailureCode    String?          @map("pod_failure_code")
  podNote           String?          @map("pod_note")
  podCapturedAt     DateTime?        @map("pod_captured_at")
  podSignaturePath  String?          @map("pod_signature_path")
  podRecipientName  String?          @map("pod_recipient_name")
  podSignatureRefusedReason String?  @map("pod_signature_refused_reason")
  podLatitude       Float?           @map("pod_latitude")
  podLongitude      Float?           @map("pod_longitude")
  podPositionAt     DateTime?        @map("pod_position_at")

  companyId  String  @map("company_id")
  company    Company @relation(fields: [companyId], references: [id])
  orderId    String  @map("order_id")
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String? @map("customer_id")
  customer   User?   @relation("CustomerDeliveries", fields: [customerId], references: [id], onDelete: SetNull)

  trackingEvents TrackingEvent[]
  tickets        SupportTicket[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([customerId])
  @@index([orderId])
  @@index([driverId])
  @@index([status])
  @@map("deliveries")
}

/// Dernière position GPS connue d'un chauffeur (fréquence configurable par entreprise)
model DriverLocation {
  driverId  String   @id @map("driver_id")
  driver    User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  accuracy  Float?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("driver_locations")
}

model TrackingEvent {
  id          String   @id @default(cuid())
  label       String
  description String?
  latitude    Float?
  longitude   Float?
  occurredAt  DateTime @default(now()) @map("occurred_at")

  deliveryId String   @map("delivery_id")
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@map("tracking_events")
}

model OperationJob {
  id            String             @id @default(cuid())
  jobKey        String             @unique @map("job_key")
  type          OperationJobType
  status        OperationJobStatus @default(PENDING)
  payload       Json
  attempts      Int                @default(0)
  maxAttempts   Int                @default(3) @map("max_attempts")
  nextAttemptAt DateTime           @default(now()) @map("next_attempt_at")
  lockedAt      DateTime?          @map("locked_at")
  lastError     String?            @map("last_error")
  completedAt   DateTime?          @map("completed_at")

  companyId String?  @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  invoiceReminders InvoiceReminder[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@index([companyId, status])
  @@map("operation_jobs")
}

model Invoice {
  id        String        @id @default(cuid())
  reference String        @unique
  status    InvoiceStatus @default(PENDING)
  amount    Decimal       @db.Decimal(10, 2)
  lineItems Json          @default("[]") @map("line_items")
  notes     String?
  dueDate   DateTime?     @map("due_date")
  paidAt    DateTime?     @map("paid_at")
  pdfUrl    String?       @map("pdf_url")

  companyId  String  @map("company_id")
  company    Company @relation(fields: [companyId], references: [id])
  orderId    String? @map("order_id")
  order      Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerId String? @map("customer_id")
  customer   User?   @relation("CustomerInvoices", fields: [customerId], references: [id], onDelete: SetNull)

  reminders InvoiceReminder[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([customerId])
  @@index([status])
  @@index([orderId])
  @@map("invoices")
}

/// DEMO-3 : trace d'une relance de facture (qui, quand, canal, résultat).
/// result : QUEUED, SENT, NOT_SENT_EMAIL_NOT_CONFIGURED, NOT_SENT_NO_RECIPIENT,
/// NOT_SENT_CLIENT_PREFERENCES, NOT_SENT_INVOICE_SETTLED.
model InvoiceReminder {
  id          String    @id @default(cuid())
  channel     String    @default("EMAIL")
  result      String
  completedAt DateTime? @map("completed_at")

  invoiceId      String        @map("invoice_id")
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  companyId      String        @map("company_id")
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sentById       String?       @map("sent_by_id")
  sentBy         User?         @relation(fields: [sentById], references: [id], onDelete: SetNull)
  operationJobId String?       @map("operation_job_id")
  operationJob   OperationJob? @relation(fields: [operationJobId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([invoiceId, createdAt])
  @@index([companyId, createdAt])
  @@index([sentById])
  @@index([operationJobId])
  @@map("invoice_reminders")
}

model SupportTicket {
  id          String                @id @default(cuid())
  subject     String
  message     String
  status      SupportTicketStatus   @default(OPEN)
  priority    SupportTicketPriority @default(NORMAL)
  contactType SupportContactType?   @map("contact_type")

  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id])

  customerId String @map("customer_id")
  customer   User   @relation("CustomerTickets", fields: [customerId], references: [id], onDelete: Cascade)

  relatedOrderId    String?   @map("related_order_id")
  relatedOrder      Order?    @relation(fields: [relatedOrderId], references: [id], onDelete: SetNull)
  relatedDeliveryId String?   @map("related_delivery_id")
  relatedDelivery   Delivery? @relation(fields: [relatedDeliveryId], references: [id], onDelete: SetNull)

  messages SupportTicketMessage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([companyId])
  @@index([status])
  @@index([relatedDeliveryId])
  @@index([relatedOrderId])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id      String  @id @default(cuid())
  body    String
  isStaff Boolean @default(false) @map("is_staff")

  ticketId String        @map("ticket_id")
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId String        @map("author_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([ticketId])
  @@map("support_ticket_messages")
}

model CustomerAddress {
  id         String  @id @default(cuid())
  label      String
  address    String
  city       String?
  postalCode String? @map("postal_code")
  isDefault  Boolean @default(false) @map("is_default")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("customer_addresses")
}

model RecurringOrder {
  id                   String              @id @default(cuid())
  label                String
  frequency            RecurrenceFrequency
  intervalValue        Int                 @default(1) @map("interval_value")
  intervalUnit         RecurrenceUnit      @default(WEEKS) @map("interval_unit")
  status               RecurrenceStatus    @default(ACTIVE)
  startAt              DateTime            @default(now()) @map("start_at")
  nextRunAt            DateTime            @map("next_run_at")
  endAt                DateTime?           @map("end_at")
  deliveryCategory     DeliveryCategory    @default(STANDARD) @map("delivery_category")
  pickupAddress        String?             @map("pickup_address")
  pickupCity           String?             @map("pickup_city")
  pickupPostalCode     String?             @map("pickup_postal_code")
  pickupInstructions   String?             @map("pickup_instructions")
  pickupStops          Json?               @map("pickup_stops")
  shippingAddress      String              @map("shipping_address")
  shippingCity         String?             @map("shipping_city")
  shippingPostalCode   String?             @map("shipping_postal_code")
  deliveryInstructions String?             @map("delivery_instructions")
  notes                String?
  items                Json

  companyId  String  @map("company_id")
  company    Company @relation(fields: [companyId], references: [id])
  customerId String  @map("customer_id")
  customer   User    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  orders Order[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([companyId])
  @@index([status])
  @@map("recurring_orders")
}

/// Coordination opérationnelle de la commande, distincte des tickets d'assistance.
model OrderMessage {
  id            String               @id @default(cuid())
  orderId       String               @map("order_id")
  order         Order                @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  authorId      String               @map("author_id")
  author        User                 @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  authorName    String               @map("author_name")
  authorRole    String               @map("author_role")
  body          String
  kind          String               @default("QUESTION")
  internal      Boolean              @default(false)
  requestKey    String               @map("request_key")
  createdAt     DateTime             @default(now()) @map("created_at")
  notifications ClientNotification[]

  @@unique([orderId, authorId, requestKey])
  @@index([orderId, createdAt, id])
  @@index([authorId])
  @@map("order_messages")
}

model OrderThreadRead {
  id      String   @id @default(cuid())
  orderId String   @map("order_id")
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userId  String   @map("user_id")
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  seenAt  DateTime @map("seen_at")
  seenId  String   @map("seen_id")

  @@unique([orderId, userId])
  @@index([userId])
  @@map("order_thread_reads")
}

/// Durable sandbox ledger. Never exposed to browser clients or Supabase Data API.
model SaasBillingAccount {
  id String @id @default(cuid())
  signupId String @unique @map("signup_id")
  signup SignupJourney @relation(fields: [signupId], references: [id], onDelete: Restrict)
  subscriptionId String? @unique @map("subscription_id")
  subscription SaasSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  providerSubscriptionId String? @unique @map("provider_subscription_id")
  providerCustomerId String? @unique @map("provider_customer_id")
  checkoutId String? @unique @map("checkout_id")
  state Json
  revision Int @default(0)
  pendingOperationId String? @map("pending_operation_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  operations SaasBillingOperation[]
  @@map("saas_billing_accounts")
}

model SaasBillingOperation {
  id String @id
  accountId String @map("account_id")
  account SaasBillingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  kind String
  status String @default("PREPARED")
  input Json
  result Json?
  attempts Int @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  @@index([accountId, createdAt])
  @@index([status, createdAt])
  @@map("saas_billing_operations")
}

enum PlatformAccessDecision {
  ALLOWED
  DENIED
}

enum PlatformAccessResource {
  OVERVIEW
  SAAS_HEALTH
  SERVICE_HEALTH
  COMPANIES
  COMPANY_DETAIL
  USERS
  SUBSCRIPTIONS
  SUPPORT_TICKETS
  OPERATION_JOBS
  INCIDENTS
  ACCESS_EVENTS
  CONTACT_MESSAGES
  SALES_CODES
  SALES_COMMISSIONS
}

/// Lecture plateforme journalisée. Aucune relation, aucune donnée personnelle.
model PlatformAccessEvent {
  id         String                   @id @default(cuid())
  occurredAt DateTime                 @map("occurred_at")
  expiresAt  DateTime                 @map("expires_at")
  actorId    String                   @map("actor_id")
  role       SystemRole
  method     String
  resource   PlatformAccessResource
  decision   PlatformAccessDecision

  @@index([occurredAt])
  @@index([expiresAt])
  @@index([actorId])
  @@map("platform_access_events")
}

/// Message du formulaire Contact public (GROWTH-1, décision C10), lu par le super-administrateur.
/// L'adresse IP n'est jamais stockée : seule une empreinte HMAC sert à limiter le débit.
model ContactMessage {
  id         String   @id @default(cuid())
  name       String
  email      String
  company    String?
  phone      String?
  message    String
  sourceHash String   @map("source_hash")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([sourceHash, createdAt])
  @@map("contact_messages")
}

enum SalesCommissionLevel {
  REFERRER
  ASSISTED
  AUTONOMOUS
}

/// SALES-1, décision C10 : un code permanent par commercial, créé par le super-administrateur,
/// sans date de fin et désactivable. L'adresse du commercial est unique : un seul code chacun.
model SalesCode {
  id           String               @id @default(cuid())
  code         String               @unique
  sellerName   String               @map("seller_name")
  sellerEmail  String               @unique @map("seller_email")
  level        SalesCommissionLevel
  createdById  String               @map("created_by_id")
  disabledAt   DateTime?            @map("disabled_at")
  disabledById String?              @map("disabled_by_id")
  createdAt    DateTime             @default(now()) @map("created_at")

  signupJourneys SignupJourney[]
  attributions   SalesAttribution[]

  @@map("sales_codes")
}

/// Attribution figée à l'activation : niveau, taux, fenêtre de douze mois et lignes initiales.
model SalesAttribution {
  id            String               @id @default(cuid())
  companyId     String               @unique @map("company_id")
  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesCodeId   String               @map("sales_code_id")
  salesCode     SalesCode            @relation(fields: [salesCodeId], references: [id], onDelete: Restrict)
  signupId      String               @unique @map("signup_id")
  level         SalesCommissionLevel
  rateBps       Int                  @map("rate_bps")
  attributedAt  DateTime             @map("attributed_at")
  eligibleUntil DateTime             @map("eligible_until")
  snapshot      Json
  createdAt     DateTime             @default(now()) @map("created_at")

  commissionEntries SalesCommissionEntry[]

  @@index([salesCodeId, attributedAt])
  @@map("sales_attributions")
}

/// Commission théorique d'un règlement, clé déterministe ; aucun versement automatisé.
model SalesCommissionEntry {
  id              String           @id
  attributionId   String           @map("attribution_id")
  attribution     SalesAttribution @relation(fields: [attributionId], references: [id], onDelete: Cascade)
  settlementKey   String           @map("settlement_key")
  explanation     String
  eligibleHtCents Int              @map("eligible_ht_cents")
  rateBps         Int              @map("rate_bps")
  commissionCents Int              @map("commission_cents")
  receivedAt      DateTime         @map("received_at")
  createdAt       DateTime         @default(now()) @map("created_at")

  @@unique([attributionId, settlementKey])
  @@index([receivedAt])
  @@map("sales_commission_entries")
}

/// SEC-2 : échecs de connexion récents, identifiés par une empreinte HMAC de l'e-mail
/// normalisé ou de la source (jamais la valeur brute). Purgés au-delà de 15 minutes.
model AuthLoginFailure {
  id        String   @id @default(cuid())
  keyHash   String   @map("key_hash")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([keyHash, createdAt])
  @@index([createdAt])
  @@map("auth_login_failures")
}

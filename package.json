{
  "name": "tutelliv",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-dev.mjs && next dev --turbopack",
    "dev:fast": "next dev",
    "dev:turbo": "node scripts/ensure-dev.mjs && next dev --turbopack",
    "dev:clean": "rm -rf .next node_modules/.cache && next dev",
    "build": "node scripts/ensure-build.mjs && next build",
    "build:clean": "rm -rf .next node_modules/.cache && next build",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:sync-schema": "dotenv -e .env.local -- tsx scripts/db-sync-schema.ts",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:seed": "dotenv -e .env.local -- tsx prisma/seed.ts",
    "db:seed-test-accounts": "dotenv -e .env.local -- tsx scripts/seed-test-accounts.ts",
    "db:seed-random-orders": "dotenv -e .env.local -- tsx scripts/seed-random-orders.ts",
    "db:seed-demo": "dotenv -e .env.local -- tsx scripts/seed-demo-environment.ts",
    "db:seed-offer-environments": "dotenv -e .env.preproduction.local -- tsx scripts/seed-offer-environments.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:connected": "dotenv -e .env.local -- tsx scripts/test-v1/connected.ts outputs/test2/connected.json",
    "test:e2e": "playwright test",
    "test:v1:browser-fixture:setup": "tsx scripts/test-v1/setup-browser-fixture.ts",
    "test:v1:browser-fixture:cleanup": "tsx scripts/test-v1/cleanup-browser-fixture.ts",
    "test:v1": "npm test && npm run test:connected && npm run test:e2e && node scripts/test-v1/verify-output.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:support1": "dotenv -e .env.local -- tsx scripts/support1/connected.ts outputs/support1/connected.json",
    "test:support1:e2e": "playwright test tests/e2e/support.spec.ts",
    "test:onboard1": "dotenv -e .env.local -- tsx scripts/onboard1/connected.ts outputs/onboard1/connected.json",
    "test:onboard1:e2e": "playwright test tests/e2e/onboarding.spec.ts",
    "test:ops01": "dotenv -e .env.local -- tsx scripts/ops01/connected.ts outputs/ops01/connected.json",
    "test:special1": "dotenv -e .env.local -- tsx scripts/special1/connected.ts outputs/special1/connected.json",
    "test:demo1": "dotenv -e .env.local -- tsx scripts/demo1/connected.ts outputs/demo1/connected.json",
    "demo2:prepare": "dotenv -e .env.preproduction.local -- tsx scripts/demo2/prepare-pool.ts",
    "demo2:maintain": "dotenv -e .env.preproduction.local -- tsx scripts/demo2/maintain-pool.ts",
    "test:demo2": "dotenv -e .env.preproduction.local -- tsx scripts/demo2/connected.ts outputs/demo2/connected.json",
    "test:demo2:http": "dotenv -e .env.preproduction.local -- tsx scripts/demo2/http-benchmark.ts outputs/demo2/http.json",
    "test:signup1": "dotenv -e .env.preproduction.local -- tsx scripts/signup1/connected.ts outputs/signup1/connected.json",
    "cost1:model": "node scripts/cost1/model.mjs outputs/cost1/model.json",
    "test:ops03b": "dotenv -e .env.local -- tsx scripts/ops03b/connected.ts outputs/ops03b/connected.json",
    "ops03b:rehearse-preproduction": "dotenv -e .env.preproduction.local -e .env.ops03b.local -- tsx scripts/ops03b/rehearse-preproduction.ts outputs/ops03b/preproduction-rehearsal.json",
    "ops03b:test-channel": "dotenv -e .env.preproduction.local -e .env.ops03b.local -- tsx scripts/ops03b/rehearse-preproduction.ts outputs/ops03b/test-channel.json --alert-only",
    "test:data02": "dotenv -e .env.local -- tsx scripts/data02/connected.ts outputs/data02/connected.json",
    "test:data02:demo-retention": "dotenv -e .env.local -- tsx scripts/data02/demo-retention-connected.ts",
    "data02:demo-cleanup": "dotenv -e .env.local -- tsx scripts/data02/cleanup-demo.ts",
    "data02:demo-legacy-inventory": "dotenv -e .env.local -- tsx scripts/data02/inventory-legacy-demos.ts",
    "audit:env1": "dotenv -e .env.local -- tsx scripts/env1/inventory.ts outputs/env1/inventory.json",
    "audit:db1": "dotenv -e .env.local -- tsx scripts/db1/inventory.ts outputs/db1/inventory.json outputs/db1/prisma-baseline-draft.sql outputs/db1/security-baseline-draft.sql",
    "db1:verify-preproduction": "tsx scripts/db1/verify-preproduction.ts outputs/db1/preproduction-validation.json",
    "db1:rehearse-preproduction": "dotenv -e .env.preproduction.local -- tsx scripts/db1/rehearse-migration-restore.ts outputs/db1/migration-restore-rehearsal.json",
    "audit:ops03a": "dotenv -e .env.local -- tsx scripts/ops03a/inventory.ts outputs/ops03a/inventory.json",
    "ops03a:rehearse-preproduction": "dotenv -e .env.preproduction.local -- tsx scripts/ops03a/rehearse-backup-restore.ts outputs/ops03a/restore-rehearsal.json",
    "ops03a:restore-provider-storage": "dotenv -e .env.ops03a-storage.local -- tsx scripts/ops03a/restore-provider-storage.ts",
    "ci:secrets": "node scripts/ci/scan-secrets.mjs",
    "ci:preprod-env": "tsx scripts/ci/verify-preproduction-env.ts",
    "todo:progress": "node scripts/docs/update-todo-progress.mjs",
    "docs:verify": "npm run todo:progress && node scripts/docs/verify-docs.mjs outputs/doc1/verification.json",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "@tanstack/react-query": "^5.101.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.17.0",
    "next": "^15.5.28",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.77.0",
    "react-leaflet": "^5.0.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.9.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.30",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}

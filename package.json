{
  "name": "annona",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18 <23"
  },
  "scripts": {
    "dev": "node scripts/ensure-dev.mjs && next dev --turbopack",
    "dev:fast": "next dev",
    "dev:turbo": "node scripts/ensure-dev.mjs && next dev --turbopack",
    "dev:clean": "rm -rf .next node_modules/.cache && next dev",
    "build": "node scripts/ensure-build.mjs && next build",
    "build:clean": "rm -rf .next node_modules/.cache && next build",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:sync-schema": "dotenv -e .env.local -- tsx scripts/db-sync-schema.ts",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:seed": "dotenv -e .env.local -- tsx prisma/seed.ts",
    "platform:create-owner": "dotenv -e .env.preproduction.local -- tsx scripts/platform/create-owner.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate && node scripts/maps/copy-maplibre-worker.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "mobile:sync": "cap sync",
    "mobile:ios": "cap sync ios && cap open ios",
    "mobile:android": "cap sync android && cap open android",
    "mobile:build:ios": "cap sync ios && xcodebuild -project ios/App/App.xcodeproj -scheme App -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build",
    "mobile:assets": "capacitor-assets generate --assetPath mobile/assets --iconBackgroundColor '#2B211B' --iconBackgroundColorDark '#2B211B' --splashBackgroundColor '#F5F8F6' --splashBackgroundColorDark '#0E1310' --ios --android",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:support1": "dotenv -e .env.local -- tsx scripts/support1/connected.ts outputs/support1/connected.json",
    "test:support1:e2e": "playwright test tests/e2e/support.spec.ts",
    "recette:sec05-real": "dotenv -e .env.local -- tsx scripts/email/sec05-real.ts",
    "test:email-sec05": "node --import tsx --test tests/password-link.test.ts tests/transactional-email.test.ts tests/email-template.test.ts tests/notification-idempotency.test.ts tests/operation-jobs.test.ts",
    "test:admin01": "node --import tsx --test tests/admin01-support.test.ts tests/admin01-operation-jobs.test.ts tests/admin01-service-health.test.ts tests/admin01-companies.test.ts tests/admin01-user-mutation-boundary.test.ts tests/admin01-platform-settings-boundary.test.ts tests/admin01-users-list.test.ts tests/admin01-platform-route-boundary.test.ts tests/admin01-company-config-boundary.test.ts tests/admin01-company-operation-jobs-boundary.test.ts tests/admin01-company-support-boundary.test.ts tests/admin01-overview-minimization.test.ts tests/admin01-platform-api-role.test.ts tests/admin01-platform-route-inventory.test.ts tests/admin01-tenant-api-boundary-inventory.test.ts tests/admin01-indirect-company-boundaries.test.ts tests/admin01-no-impersonation.test.ts tests/admin01-support-page.test.ts tests/admin01-operation-jobs-page.test.ts tests/admin01-company-detail.test.ts",
    "test:ops03b": "dotenv -e .env.local -- tsx scripts/ops03b/connected.ts outputs/ops03b/connected.json",
    "ops03b:rehearse-preproduction": "dotenv -e .env.preproduction.local -e .env.ops03b.local -- tsx scripts/ops03b/rehearse-preproduction.ts outputs/ops03b/preproduction-rehearsal.json",
    "ops03b:test-channel": "dotenv -e .env.preproduction.local -e .env.ops03b.local -- tsx scripts/ops03b/rehearse-preproduction.ts outputs/ops03b/test-channel.json --alert-only",
    "test:data02:inventory": "node --import tsx --test tests/data02-inventory.test.ts",
    "test:data02:export-contract": "node --import tsx --test tests/data02-export-contract.test.ts",
    "push:setup-keys": "node scripts/driver-push/setup-vapid-keys.mjs",
    "audit:env1": "dotenv -e .env.local -- tsx scripts/env1/inventory.ts outputs/env1/inventory.json",
    "audit:db1": "dotenv -e .env.local -- tsx scripts/db1/inventory.ts outputs/db1/inventory.json outputs/db1/prisma-baseline-draft.sql outputs/db1/security-baseline-draft.sql",
    "audit:ops03a": "dotenv -e .env.local -- tsx scripts/ops03a/inventory.ts outputs/ops03a/inventory.json",
    "ops03a:restore-provider-storage": "dotenv -e .env.ops03a-storage.local -- tsx scripts/ops03a/restore-provider-storage.ts",
    "ci:secrets": "node scripts/ci/scan-secrets.mjs",
    "ci:preprod-env": "tsx scripts/ci/verify-preproduction-env.ts",
    "todo:progress": "node scripts/docs/update-todo-progress.mjs",
    "docs:verify": "npm run todo:progress && node scripts/docs/verify-docs.mjs outputs/doc1/verification.json",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "env2:verify-dev": "dotenv -e .env.local -- tsx scripts/env2/verify-dev-env.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.0",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@hookform/resolvers": "^5.4.0",
    "@maplibre/maplibre-gl-leaflet": "0.1.4",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "@tanstack/react-query": "^5.101.0",
    "@types/nodemailer": "^8.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.17.0",
    "maplibre-gl": "6.13.0",
    "motion": "^14.7.1",
    "next": "^15.5.28",
    "nodemailer": "^10.3.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.77.0",
    "react-leaflet": "^5.0.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.9.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.30",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}

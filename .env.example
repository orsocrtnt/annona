# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Tutelliv

# Invitations et récupération : activer APRÈS configuration SMTP et modèles Supabase
# Voir docs/AUTH_EMAIL_SETUP.md. Aucun envoi Auth tant que ce flag est false.
AUTH_EMAIL_LINKS_ENABLED=false

# SIGNUP-1 : adaptateur déterministe sans transaction réelle.
# Autorisé uniquement en local et sur Vercel Preview ; la route refuse Vercel Production.
SIGNUP_PAYMENT_ADAPTER=fake

# Bouton Support public (accueil, inscription, connexion). Vide = support@tutelliv.fr
NEXT_PUBLIC_SUPPORT_EMAIL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Anti-abus : secret HMAC des empreintes (source du formulaire Contact, e-mail et source
# des échecs de connexion). Repli sur SUPABASE_SERVICE_ROLE_KEY si absent.
CONTACT_HMAC_SECRET=your_long_random_contact_hmac_secret

# Cron (génération des commandes récurrentes)
# Secret partagé entre le planificateur (Vercel Cron) et /api/cron/recurring-orders
CRON_SECRET=change_me_long_random_string

# Exploitation : secret distinct pour /api/health?deep=1.
# Le webhook générique est optionnel ; utiliser HTTPS en production et un jeton dédié.
OPS_HEALTH_SECRET=change_me_another_long_random_string
# Boîte alertée par e-mail (une fois par jour et par type de panne). Vide : EMAIL_TEST_RECIPIENT, sinon aucun e-mail.
OPS_ALERT_RECIPIENT=
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_TOKEN=

# OPS-03B : moniteur externe à Vercel, uniquement sur la préproduction isolée.
# Ces valeurs sont copiées dans Supabase Vault par la répétition opérateur.
OPS_MONITOR_APP_URL=
OPS_MONITOR_WEBHOOK_URL=
VERCEL_AUTOMATION_BYPASS_SECRET=

# DATA-02 : vide = suppression des démos désactivée.
# Outil opérateur : autorisation exacte ci-dessous ET option --apply.
# Route préparée /api/cron/demo-cleanup : exige aussi CRON_SECRET ; aucun horaire
# n'est installé dans vercel.json, donc elle ne s'exécute pas automatiquement.
DEMO_CLEANUP_ENABLED=

# Database (PostgreSQL via Supabase)
# DATABASE_URL : pooler (port 6543) — pour la production / serverless
# DIRECT_URL   : connexion directe utilisée par les commandes Prisma de schéma
# Le runtime applicatif utilise DATABASE_URL, y compris en développement.
# Utiliser une base de développement isolée ; ne pas recopier des identifiants de production.
DATABASE_URL=postgresql://postgres:password@localhost:5432/tutelliv?pgbouncer=true
DIRECT_URL=postgresql://postgres:password@localhost:5432/tutelliv

# Développement seulement : compte administrateur préféré par les scripts de seed.
# Laisser vide pour sélectionner le premier administrateur/entreprise fictive disponible.
SEED_COMPANY_ADMIN_EMAIL=

# E-mails métier : disabled par défaut, test vers une boîte unique, live vers le destinataire.
# Ne jamais passer à live avant validation du domaine et de l'environnement.
EMAIL_DELIVERY_MODE=disabled
EMAIL_TEST_RECIPIENT=
# Boîte de l'équipe alertée à chaque message du formulaire Contact. Vide : EMAIL_TEST_RECIPIENT, sinon aucune alerte (le message reste dans le back-office).
CONTACT_ALERT_RECIPIENT=
# Utiliser un expéditeur vérifié chez Resend.
# Notifications « Nouvelle mission » au livreur (web push) : paire créée par `npm run push:setup-keys`.
# Sans ces deux valeurs, la fonction reste inactive. VAPID_SUBJECT : URL ou mailto: de contact (défaut https://tutelliv.fr).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

RESEND_API_KEY=
MAIL_FROM=
# EMAIL_FROM peut remplacer MAIL_FROM ; ne pas configurer les deux inutilement.
# EMAIL_FROM=

# Cartographie : aucun abonnement engagé. Variables publiques figées au build.
# Laisser vide : fond OSM public, zoom 1–19, sans garantie de disponibilité.
# Un fond personnalisé exige URL, attribution HTML de confiance et zoom natif documenté.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
NEXT_PUBLIC_MAP_MAX_NATIVE_ZOOM=19
# Itinéraires (navigation du livreur, cartes du dispatch, démo) : calculés par le serveur seulement
# (/api/maps/route, LEGAL-1), chez un endpoint approuvé ; vides = pas de tracé. HTTPS obligatoire.
# Recommandé : DRIVE_ROUTE_IGN_URL=https://data.geopf.fr/navigation/itineraire (Géoplateforme IGN).
# Ne pas utiliser les démonstrateurs publics (router.project-osrm.org) avec des données clients.
DRIVE_ROUTE_OSRM_URL=
DRIVE_ROUTE_IGN_URL=
# Endpoint serveur compatible GeoJSON IGN ; vide = API Géoplateforme actuelle.
GEOCODING_URL=
# Conditions, limites et décision avant vente : docs/operations/map-providers.md

# PERF-01 : pool borné par instance (défaut 5).
# DATABASE_CONNECTION_LIMIT=5
# Mode session Supabase optionnel pour serveur local permanent ; conserve le mode transactionnel par défaut.
# DATABASE_CONNECTION_MODE=session

# Playwright : laisser vide pour démarrer automatiquement le serveur local de recette.
# E2E_BASE_URL=http://127.0.0.1:3106
# E2E_SKIP_WEB_SERVER=0
# PLAYWRIGHT_CHANNEL=chrome

# SAAS-01B : sandbox exclusivement ; aucun compte/secret provisionné automatiquement.
# SIGNUP_PAYMENT_ADAPTER=stripe-sandbox
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Session Supabase personnelle et temporaire du Super Admin qui autorise un remboursement CLI.
# TUTELLIV_OPERATOR_ACCESS_TOKEN=
# API Stripe épinglée côté serveur ; VERCEL_ENV=production et sk_live_* refusés.

# Prospection (ADMIN-ESPACE lot 5) : lecture seule de la Google Sheet TutelLiv_Suivi_Prospection_2026
# par un compte de service Google (portée spreadsheets.readonly). Sans ces trois valeurs, la page
# /admin/prospection affiche « À brancher ». Pas à pas : docs/operations/prospection/SHEET.md.
# Clé : valeur « private_key » du fichier JSON, sur une ligne avec des \n. Ne jamais la versionner.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
# Identifiant de la Sheet (ou son adresse complète) ; ligne des en-têtes (5 par défaut).
PROSPECTION_SHEET_ID=
# PROSPECTION_SHEET_HEADER_ROW=5

# Commande par message IA (facultatif, désactivée par défaut) : clé serveur Anthropic.
# Sans valeur, la fonction reste indisponible ; il faut aussi l’activer par entreprise.
ANTHROPIC_API_KEY=
# Réception des e-mails de commande (Resend Inbound) : domaine dont le MX pointe vers Resend et secret du webhook.
INBOUND_EMAIL_DOMAIN=
RESEND_INBOUND_WEBHOOK_SECRET=
# Commandes WhatsApp (WHATSAPP-1, option A) : application Meta, numéro de TutelLiv et webhook /api/webhooks/whatsapp.
# Sans ces quatre valeurs, le réglage WhatsApp reste indisponible.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DISPLAY_NUMBER=

# ADMIN-ESPACE lot 5 : campagnes de prospection envoyées depuis la boîte OVH (jamais par Resend).
# Sans mot de passe, /admin/campaigns prépare les campagnes mais n'envoie rien.
PROSPECT_SMTP_PASSWORD=
# PROSPECT_SMTP_HOST=smtp.mail.ovh.net
# PROSPECT_SMTP_PORT=465
# PROSPECT_SMTP_USER=orso@tutelliv.fr
# PROSPECT_LINK_BASE_URL=https://tutelliv.fr

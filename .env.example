# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Tutelliv

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cron (génération des commandes récurrentes)
# Secret partagé entre le planificateur (Vercel Cron) et /api/cron/recurring-orders
CRON_SECRET=change_me_long_random_string

# Database (PostgreSQL via Supabase)
# DATABASE_URL : pooler (port 6543) — pour la production / serverless
# DIRECT_URL   : connexion directe (port 5432) — utilisée automatiquement en dev (plus rapide)
DATABASE_URL=postgresql://postgres:password@localhost:5432/tutelliv?pgbouncer=true
DIRECT_URL=postgresql://postgres:password@localhost:5432/tutelliv
